{
  "name": "zmatrix",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "zMatrix · 本地优先的自媒体矩阵工作台",
  "license": "MIT",
  "author": "zJay26",
  "homepage": "https://github.com/zJay26/zMatrix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zJay26/zMatrix.git"
  },
  "bugs": {
    "url": "https://github.com/zJay26/zMatrix/issues"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-key.mjs && wxt prepare",
    "dev": "wxt -b edge",
    "build": "wxt build -b edge",
    "zip": "wxt zip -b edge",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite --config vite.preview.config.ts --host 127.0.0.1",
    "preview:built": "node scripts/preview-built.mjs",
    "package": "npm run typecheck && npm test && npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "html-to-image": "1.11.13",
    "katex": "0.18.7",
    "lucide-react": "1.47.0",
    "mermaid": "11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "0.3.0",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/wicg-file-system-access": "2023.10.7",
    "@vitejs/plugin-react": "6.1.1",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wxt": "0.21.4"
